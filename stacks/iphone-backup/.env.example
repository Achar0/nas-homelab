# Folder on the NAS that receives the backup (one subfolder per device UDID)
BACKUP_DIR=/volume1/@home/<user>/iPhone-Backup
# Backup encryption password. KEEP IT SAFE: without it the backup can't be restored.
BACKUP_PASSWORD=change-me
# Private ntfy topic for failure alerts; empty = no alerts
NTFY_URL=https://ntfy.sh/<your-private-topic>
