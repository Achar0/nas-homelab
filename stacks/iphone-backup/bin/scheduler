#!/bin/bash
# Every 15 min in the evening window: if a backup is due and the iPhone is on
# home Wi-Fi, start it. iOS 27 asks for the PIN on the phone before every
# encrypted backup, so iphone-backup pushes a "enter your PIN" notification.
# At most one attempt per evening; nothing happens at night.
set -uo pipefail
source /usr/local/bin/common.sh

WINDOW_START=${WINDOW_START:-21}   # hour, inclusive  (after dinner)
WINDOW_END=${WINDOW_END:-23}       # hour, exclusive  (before sleep)
MIN_HOURS=${MIN_HOURS:-20}         # don't back up more often than this
ALERT_HOURS=${ALERT_HOURS:-72}     # past this, one ntfy alert per evening

while true; do
    sleep 900
    [ -n "$(udid)" ] || continue                     # not paired yet
    HOUR=$((10#$(date +%H)))
    [ "$HOUR" -ge "$WINDOW_START" ] && [ "$HOUR" -lt "$WINDOW_END" ] || continue
    # a backup is running right now (e.g. a manual one): nothing to do
    flock -n "$STATE/backup.lock" true || continue

    # never backed up yet → count from the pairing time, not from 1970
    LAST=$(cat "$STATE/last_success" 2>/dev/null || stat -c %Y "$UDID_FILE")
    AGE_H=$(( ($(date +%s) - LAST) / 3600 ))
    TODAY=$(date +%F)

    if [ "$AGE_H" -ge "$ALERT_HOURS" ] && [ "$(cat "$STATE/alerted" 2>/dev/null)" != "$TODAY" ]; then
        echo "$TODAY" > "$STATE/alerted"
        notify "iPhone not backed up" "Last good backup ${AGE_H} h ago." high
    fi

    [ "$AGE_H" -ge "$MIN_HOURS" ] || continue
    [ "$(cat "$STATE/attempted" 2>/dev/null)" != "$TODAY" ] || continue   # one try per evening
    if wifi_visible; then
        echo "$TODAY" > "$STATE/attempted"
        iphone-backup || true
    else
        write_status waiting "iPhone not seen on Wi-Fi"
    fi
done
