#!/bin/bash
# Quick overview:  docker exec iphone-backup iphone-status
source /usr/local/bin/common.sh

echo "Paired UDID : $(udid || true)"
visible -l && echo "Visible     : USB" || true
visible -n && echo "Visible     : Wi-Fi" || true
LAST=$(cat "$STATE/last_success" 2>/dev/null || echo 0)
[ "$LAST" -gt 0 ] && echo "Last backup : $(date -d "@$LAST" '+%F %H:%M') ($(( ($(date +%s) - LAST) / 3600 )) h ago)" \
                  || echo "Last backup : never"
echo "Size        : $(du -sh "$BACKUP_ROOT/$(udid)" 2>/dev/null | cut -f1)"
echo "--- last log lines"
tail -n 8 "$LOG_FILE" 2>/dev/null
