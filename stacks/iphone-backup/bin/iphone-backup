#!/bin/bash
# Run one backup now. Default: over Wi-Fi. --usb: over the cable.
# BACKUP_DEBUG=1 in the environment adds protocol debugging to the log.
# iOS 27 asks for the PIN on the iPhone each time: a ntfy push says so.
#   docker exec -it iphone-backup iphone-backup [--usb]
set -uo pipefail
source /usr/local/bin/common.sh

[ -n "$(udid)" ] || { echo "Not paired yet: run iphone-pair first"; exit 1; }
[ -n "${BACKUP_PASSWORD:-}" ] || { echo "BACKUP_PASSWORD missing in .env"; exit 1; }

if [ "${1:-}" = "--usb" ]; then NET=(); WHERE=USB; else NET=(-n); WHERE=Wi-Fi; fi

# only one backup at a time (scheduler and manual runs share the lock)
exec 9>"$STATE/backup.lock"
flock -n 9 || { echo "A backup is already running"; exit 1; }

if [ "$WHERE" = Wi-Fi ] && ! wifi_visible; then
    echo "iPhone not seen on Wi-Fi (is it on the home network?)"; exit 1
fi
as_user mkdir -p "$BACKUP_ROOT"
log "Backup started over $WHERE"
START=$(date +%s)
# idevicebackup2 is incremental: it only transfers what changed since last time.
# BACKUP_PASSWORD is read from the environment, never put on the command line.
# Progress bars are dropped from the log (they made it grow by MBs per run).
FIRST=$(( $(wc -l < "$LOG_FILE") + 1 ))     # where this run starts in the log
(
    as_user env BACKUP_PASSWORD="$BACKUP_PASSWORD" \
        stdbuf -oL -eL idevicebackup2 -u "$(udid)" "${NET[@]}" ${BACKUP_DEBUG:+-d} backup "$BACKUP_ROOT" 2>&1 \
        | stdbuf -oL tr '\r' '\n' | grep --line-buffered -av '^\[=*' >>"$LOG_FILE"
    echo "${PIPESTATUS[0]}" > "$STATE/rc"
) &
JOB=$!

# iOS 27 asks for the iPhone PIN before every encrypted backup. While the log's
# last line is that request: push a notification once, give up after PIN_TIMEOUT.
PIN_TIMEOUT=$(( ${PIN_TIMEOUT_MIN:-30} * 60 ))
ASKED=0; TIMED_OUT=0
while kill -0 "$JOB" 2>/dev/null; do
    sleep 5
    LAST_LINE=$(tail -n +"$FIRST" "$LOG_FILE" | grep -av '^$' | tail -n 1)
    [[ $LAST_LINE == *"Waiting for passcode"* ]] || continue
    if [ "$ASKED" -eq 0 ]; then
        ASKED=$(date +%s)
        log "Waiting for the PIN on the iPhone"
        notify "iPhone backup: enter your PIN" "Unlock the iPhone and type the PIN, the backup then runs by itself." high
    elif [ $(( $(date +%s) - ASKED )) -ge "$PIN_TIMEOUT" ]; then
        TIMED_OUT=1
        pkill -x idevicebackup2
    fi
done
wait "$JOB"
RC=$(cat "$STATE/rc" 2>/dev/null || echo 1)
MINS=$(( ($(date +%s) - START) / 60 ))

if [ "$TIMED_OUT" -eq 1 ]; then
    log "PIN not entered within ${PIN_TIMEOUT_MIN:-30} min, skipped"
    write_status skipped "PIN not entered"
    exit 2
fi

# idevicebackup2 sometimes exits 0 on failure, so also check its last lines
if [ $RC -eq 0 ] && tail -n 5 "$LOG_FILE" | grep -q "Backup Successful"; then
    date +%s > "$STATE/last_success"
    log "Backup OK in ${MINS} min"
    write_status ok "Backup OK in ${MINS} min"
else
    REASON=$(tail -n 3 "$LOG_FILE" | tr '"\n' "' " | cut -c1-200)
    log "Backup FAILED (rc=$RC) after ${MINS} min"
    write_status failed "$REASON"
    notify "iPhone backup failed" "Over $WHERE after ${MINS} min: $REASON" high
    exit 1
fi
