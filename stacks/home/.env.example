# Copy to .env on the NAS and fill in (never commit .env)
QBT_USER=
QBT_PASS=
# Uptime Kuma > Settings > API Keys (optional: without it the "service down" rules are skipped)
KUMA_API_KEY=
# Private ntfy topic for urgent pushes (same as Netwatch / Uptime Kuma)
NTFY_URL=https://ntfy.sh/<your-private-topic>
# NAS full Tailscale name (e.g. nas.<tailnet>.ts.net) to turn on HTTPS; empty = plain HTTP
NAS_TS_NAME=
