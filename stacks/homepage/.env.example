# Copy to .env on the NAS (chmod 600), then: docker compose up -d --force-recreate
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
HOMEPAGE_VAR_QBT_USER=
HOMEPAGE_VAR_QBT_PASS=
# Speedtest Tracker API token with the results:read ability
HOMEPAGE_VAR_SPEEDTEST_KEY=
HOMEPAGE_ALLOWED_HOSTS=192.168.1.14:3001,<tailscale-ip>:3001,nas.<tailnet>.ts.net:3001
